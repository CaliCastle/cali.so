{
  "name": "cali.so",
  "version": "3.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "pnpm": {
    "overrides": {
      "gray-matter>js-yaml": "3.15.1",
      "next>postcss": "8.5.26",
      "next>sharp": "0.35.3"
    }
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-og-runtime-fonts.mjs",
    "audit:prod": "node scripts/audit-production-dependencies.mjs",
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:validate": "node --test scripts/ama-migrations.test.mjs",
    "test:deployment": "node --test scripts/check-production-migrations.test.mjs scripts/comment-preview-deployment.test.mjs scripts/delete-vercel-branch-deployments.test.mjs scripts/deployment-workflows.test.mjs scripts/refresh-snapshot-validation.test.mjs scripts/verify-legacy-url-contract.test.mjs",
    "test:browser": "playwright test",
    "test:browser:hosted": "playwright test --project=chromium --grep @hosted",
    "start": "next start",
    "test:ama": "vitest run lib/ama && pnpm db:validate",
    "test:security": "vitest run lib/security",
    "test:unit": "vitest run app components db lib --exclude='**/*.live.test.ts'",
    "test:localization": "node --test scripts/localization.test.mjs",
    "test:media:catalog": "vitest run lib/media/catalog",
    "test:media:geocoding": "vitest run lib/media/geocoding",
    "test:media:alt-text": "vitest run lib/media/alt-text",
    "test:media:admin": "vitest run lib/media/admin",
    "test:media:asset-review": "vitest run lib/media/asset-review",
    "test:media:ingestion": "vitest run lib/media/ingestion lib/media/privacy",
    "test:media:photo-selection": "vitest run lib/media/photo-selection",
    "test:media:processing": "vitest run lib/media/processing --exclude='**/*.live.test.ts'",
    "test:media:purge": "vitest run lib/media/purge",
    "test:media:reconciliation": "vitest run lib/media/reconciliation",
    "test:media:storage": "vitest run lib/media/storage --exclude='**/*.live.test.ts'",
    "test:media:transfer": "vitest run lib/media/transfer",
    "test:media:storage:live": "vitest run lib/media/storage/bunny.live.test.ts",
    "verify:legacy-urls": "node scripts/verify-legacy-url-contract.mjs",
    "verify:links": "node scripts/verify-public-links.mjs",
    "verify:public-discovery": "node scripts/verify-public-discovery.mjs",
    "verify:security-boundary": "node scripts/verify-production-security-boundary.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.67",
    "@aws-sdk/client-s3": "^3.1120.0",
    "@base-ui/react": "^1.7.0",
    "@blossom-carousel/react": "^1.5.2",
    "@clerk/nextjs": "^7.8.2",
    "@js-temporal/polyfill": "^0.5.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.5",
    "ai": "^7.0.83",
    "beautiful-mermaid": "^1.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cuelume": "0.2.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "exifr": "^7.1.3",
    "framer-motion": "^13.1.1",
    "geist": "^1.7.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "heic-decode": "^2.1.0",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "next": "16.3.3",
    "next-mdx-remote": "^6.0.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "rss": "^1.2.2",
    "server-only": "^0.0.1",
    "shaders": "3.0.448",
    "sharp": "^0.35.4",
    "shiki": "^4.4.3",
    "subset-font": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@next/playwright": "16.3.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/rss": "^0.0.32",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
